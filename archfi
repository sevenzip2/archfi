archsecurebootchroot(){
	if ! sbctl status --json | grep -q '"setup_mode": *true'; then
		sbctl status
		echo ""
		echo "${txtsecurebootnosetupmode}"
		exit
	fi
	echo "sbctl create-keys"
	sbctl create-keys
	# -m keeps the Microsoft keys, needed by many GPU/NIC option ROMs
	echo "sbctl enroll-keys -m"
	if ! sbctl enroll-keys -m; then
		exit
	fi
	for efi in /usr/lib/systemd/boot/efi/systemd-boot*.efi; do
		echo "sbctl sign -s -o ${efi}.signed ${efi}"
		sbctl sign -s -o ${efi}.signed ${efi}
	done
	echo "bootctl --esp-path=/boot install"
	bootctl --esp-path=/boot install
	for efi in /boot/EFI/BOOT/BOOT*.EFI /boot/EFI/systemd/systemd-boot*.efi /boot/EFI/Linux/*.efi /boot/vmlinuz-*; do
		if [ -f ${efi} ]; then
			echo "sbctl sign -s ${efi}"
			sbctl sign -s ${efi}
		fi
	done
	echo "sbctl verify"
	sbctl verify
	echo ""
	echo "${txtsecurebootdone}"
	exit
}

archsystemdinstallchroot(){
	echo "bootctl --esp-path=/boot install"
	bootctl --esp-path=/boot install
	echo "systemctl enable systemd-boot-update.service"
