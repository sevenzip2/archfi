archswapfile(){
	size=$(dialog --backtitle "${apptitle}" --title "${txtswap}" --inputbox "${txtswapfilesize}" 0 0 "4G" 3>&1 1>&2 2>&3)
	if [ ! "$?" = "0" ]; then
		return 1
	fi
	clear
	if [[ ! "${size}" =~ ^[1-9][0-9]*[MG]$ ]]; then
		echo "${txtincorrectinput}"
		pressanykey
		return 1
	fi
	if [ "$(findmnt -no FSTYPE /mnt)" = "btrfs" ]; then
		# A swapfile can not live in a snapshotted subvolume, use the @swap subvolume (or a nested one)
		if [ ! -d /mnt/swap ]; then
			echo "btrfs subvolume create /mnt/swap"
			btrfs subvolume create /mnt/swap
		fi
		swapfile=/swap/swapfile
		echo "btrfs filesystem mkswapfile --size ${size} --uuid clear /mnt${swapfile}"
		btrfs filesystem mkswapfile --size ${size} --uuid clear /mnt${swapfile}
	else
		swapfile=/swapfile
		echo "fallocate -l ${size} /mnt${swapfile}"
		echo "chmod 600 /mnt${swapfile}"
		echo "mkswap -U clear /mnt${swapfile}"
		fallocate -l ${size} /mnt${swapfile} && chmod 600 /mnt${swapfile} && mkswap -U clear /mnt${swapfile}
	fi
	if [ "$?" = "0" ]&&! grep -q "^${swapfile} " /mnt/etc/fstab; then
		echo "echo \"${swapfile} none swap defaults 0 0\" >> /mnt/etc/fstab"
		echo "${swapfile} none swap defaults 0 0" >> /mnt/etc/fstab
	fi
	pressanykey
}

