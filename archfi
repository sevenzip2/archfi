archmenu(){
	if [ "${1}" = "" ]; then
		nextitem="."
	else
		nextitem=${1}
	fi
	# Main steps in order, used to move the cursor to the next step
	flow=("${txtsethostname}" "${txtsetkeymap}" "${txtsetlocale}" "${txtsettime}" "${txtsetrootpassword}" "${txtgenerate//%1/fstab}" "${txtswap}")
	options=()
	options+=("${txtsethostname}" "/etc/hostname")
