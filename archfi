archsystemdinstall(){
	clear
	archchroot systemdbootloaderinstall ${realrootdev}

	rootparams=$(archrootparams)
	kernels=$(archkernels)
	if [ "${kernels}" = "" ]; then
		echo "No kernel found in /mnt/boot"
		pressanykey
		return 1
	fi

	# Without the mkinitcpio microcode hook, microcode must be loaded as a separate initrd
	ucode=""
	if [[ ! "$(archhooks)" =~ [\(\ ]microcode[\)\ ] ]]; then
		for img in intel-ucode.img amd-ucode.img; do
			if [ -f /mnt/boot/${img} ]; then
				ucode="${ucode}initrd  /${img}\n"
			fi
		done
	fi

	echo ""
	echo "/mnt/boot/loader/loader.conf"
	printf "default arch-%s.conf\ntimeout 3\nconsole-mode max\neditor no\n" "$(echo "${kernels}" | head -n1)" > /mnt/boot/loader/loader.conf
	cat /mnt/boot/loader/loader.conf

	for kernel in ${kernels}; do
		echo ""
		echo "/mnt/boot/loader/entries/arch-${kernel}.conf"
		printf "title   Arch Linux (%s)\nlinux   /vmlinuz-%s\n${ucode}initrd  /initramfs-%s.img\noptions %s rw\n" \
			"${kernel}" "${kernel}" "${kernel}" "${rootparams}" > /mnt/boot/loader/entries/arch-${kernel}.conf
		cat /mnt/boot/loader/entries/arch-${kernel}.conf
		if [ -f /mnt/boot/initramfs-${kernel}-fallback.img ]; then
			echo ""
			echo "/mnt/boot/loader/entries/arch-${kernel}-fallback.conf"
			printf "title   Arch Linux (%s, fallback)\nlinux   /vmlinuz-%s\n${ucode}initrd  /initramfs-%s-fallback.img\noptions %s rw\n" \
				"${kernel}" "${kernel}" "${kernel}" "${rootparams}" > /mnt/boot/loader/entries/arch-${kernel}-fallback.conf
			cat /mnt/boot/loader/entries/arch-${kernel}-fallback.conf
		fi
	done

	pressanykey
}
archsystemduki(){
	# Unified Kernel Images in /boot/EFI/Linux are found by systemd-boot without entries
	clear
	kernels=$(archkernels)
	if [ "${kernels}" = "" ]||[ ! -d /mnt/boot/loader ]; then
		echo "${txtukirequiresystemdboot}"
		pressanykey
		return 1
	fi
	rootparams=$(archrootparams)
	echo "echo \"${rootparams} rw\" > /mnt/etc/kernel/cmdline"
	mkdir -p /mnt/etc/kernel /mnt/boot/EFI/Linux
	echo "${rootparams} rw" > /mnt/etc/kernel/cmdline
	for kernel in ${kernels}; do
		preset=/mnt/etc/mkinitcpio.d/${kernel}.preset
		if [ ! -f ${preset} ]; then
			continue
		fi
		echo ""
		echo "${preset}"
		sed -i -e "s|^#\?default_uki=.*|default_uki=\"/boot/EFI/Linux/arch-${kernel}.efi\"|" \
			-e "s|^#\?fallback_uki=.*|fallback_uki=\"/boot/EFI/Linux/arch-${kernel}-fallback.efi\"|" \
			-e "s|^default_image=|#default_image=|" \
			-e "s|^fallback_image=|#fallback_image=|" ${preset}
		if ! grep -q '^default_uki=' ${preset}; then
			echo "default_uki=\"/boot/EFI/Linux/arch-${kernel}.efi\"" >> ${preset}
		fi
		grep -E '^(PRESETS|default_uki|fallback_uki)=' ${preset}
		# Images and type 1 entries replaced by the UKI
		rm -f /mnt/boot/initramfs-${kernel}.img /mnt/boot/initramfs-${kernel}-fallback.img
		rm -f /mnt/boot/loader/entries/arch-${kernel}.conf /mnt/boot/loader/entries/arch-${kernel}-fallback.conf
	done
	echo ""
	archchroot genmkinitcpio
	sed -i "s/^default .*/default arch-$(echo "${kernels}" | head -n1).efi/" /mnt/boot/loader/loader.conf
	echo ""
	ls -l /mnt/boot/EFI/Linux
	pressanykey
}

