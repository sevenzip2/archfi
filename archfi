archswapzram(){
	clear
	echo "pacstrap /mnt zram-generator"
	pacstrap /mnt zram-generator
	echo ""
	echo "/mnt/etc/systemd/zram-generator.conf"
	printf "[zram0]\nzram-size = min(ram / 2, 8192)\ncompression-algorithm = zstd\n" > /mnt/etc/systemd/zram-generator.conf
	cat /mnt/etc/systemd/zram-generator.conf
	echo ""
	echo "/mnt/etc/sysctl.d/99-vm-zram-parameters.conf"
	printf "vm.swappiness = 180\nvm.watermark_boost_factor = 0\nvm.watermark_scale_factor = 125\nvm.page-cluster = 0\n" > /mnt/etc/sysctl.d/99-vm-zram-parameters.conf
	cat /mnt/etc/sysctl.d/99-vm-zram-parameters.conf
	echo ""
	echo "${txtswapzramzswap}"
	pressanykey
