	if [ "$(findmnt -no FSTYPE /mnt)" = "btrfs" ]; then
		subvol=$(findmnt -no OPTIONS /mnt | tr ',' '\n' | grep '^subvol=' | sed 's#^subvol=/\?##')
		if [ "${subvol}" != "" ]; then
			params="${params} rootflags=subvol=${subvol}"
		fi
	fi
	echo "${params} $(archextraparams)" | sed 's/ *$//' 
}
archkernels(){
	for kernel in /mnt/boot/vmlinuz-*; do
