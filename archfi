	options+=("${txtgenerate//%1/fstab}" "")
	options+=("${txtswap}" "zram, swapfile (${txtoptional})")
	if [ "${luksdrive}" = "1" ]; then
		options+=("${txtgenerate//%1/crypttab}" "")
		flow+=("${txtgenerate//%1/crypttab}")
	fi
	if [ "${luksroot}" = "1" ]; then
		options+=("${txtgenerate//%1/mkinitcpio.conf-luks}" "(encrypt hooks)")
		options+=("${txtluksenroll}" "TPM2, FIDO2 (${txtoptional})")
		flow+=("${txtgenerate//%1/mkinitcpio.conf-luks}" "${txtluksenroll}")
	fi
	options+=("${txtedit//%1/fstab}" "(${txtoptional})")
