archcryptparams(){
	if archsystemdinitramfs; then
		if [ "${luksenroll}" != "" ]; then
			echo "rd.luks.name=${luksrootuuid}=root rd.luks.options=${luksrootuuid}=${luksenroll}-device=auto"
		else
			echo "rd.luks.name=${luksrootuuid}=root"
		fi
	else
		echo "cryptdevice=UUID=${luksrootuuid}:root"
	fi
