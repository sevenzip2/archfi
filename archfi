selectdisk(){
		items=$(lsblk -d -p -n -l -o NAME,SIZE,TYPE | awk '$3=="disk" && $1 !~ /zram/ { print $1" "$2 }')
		options=()
		IFS_ORIG=$IFS
		IFS=$'\n'
		for item in ${items}
		do  
				options+=("${item}" "")
		done
		IFS=$IFS_ORIG
		result=$(dialog --backtitle "${apptitle}" --title "${1}" --menu "" 0 0 0 "${options[@]}" 3>&1 1>&2 2>&3)
		if [ "$?" != "0" ]
		then
				return 1
		fi
		echo ${result%%\ *}
		return 0    
}

partdev(){
	# Partition path of disk ${1} number ${2} (sda -> sda1, nvme0n1 -> nvme0n1p1, mmcblk0 -> mmcblk0p1)
	if [[ "${1}" =~ [0-9]$ ]]; then
		echo "${1}p${2}"
	else
		echo "${1}${2}"
	fi
}

parentdisk(){
	echo "/dev/$(lsblk -no PKNAME "${1}" | head -n1)"
}

partnumber(){
	cat "/sys/class/block/$(basename "$(realpath "${1}")")/partition"
}

diskpartmenu(){
	if [ "${1}" = "" ]; then
		nextitem="."
	else
		nextitem=${1}
	fi
	options=()
	if [ "${eficomputer}" == "0" ]; then
		options+=("${txtautoparts} (gpt)" "")
		options+=("${txtautoparts} (dos)" "")
	else
		options+=("${txtautoparts} (gpt,efi)" "")
		options+=("${txtautoparts} (gpt)" "")
		options+=("${txtautoparts} (dos)" "")
		options+=("${txtautoparts} (gpt,bios+efi,noswap)" "(legacy)")
	fi
	options+=("${txteditparts} (cfdisk)" "")
	options+=("${txteditparts} (cgdisk)" "")
	sel=$(dialog --backtitle "${apptitle}" --title "${txtdiskpartmenu}" --cancel-button "${txtback}" --default-item "${nextitem}" --menu "" 0 0 0 \
		"${options[@]}" \
		3>&1 1>&2 2>&3)
	if [ "$?" = "0" ]; then
		case ${sel} in
			"${txtautoparts} (dos)")
				diskpartautodos
				nextitem="${txtautoparts} (dos)"
			;;
			"${txtautoparts} (gpt)")
				diskpartautogpt
				nextitem="${txtautoparts} (gpt)"
			;;
			"${txtautoparts} (gpt,efi)")
				diskpartautoefi
				nextitem="${txtautoparts} (gpt,efi)"
			;;
			"${txtautoparts} (gpt,bios+efi,noswap)")
				diskpartautoefiusb
				nextitem="${txtautoparts} (gpt,bios+efi,noswap)"
			;;
			"${txteditparts} (cfdisk)")
				diskpartcfdisk
				nextitem="${txteditparts} (cfdisk)"
			;;
			"${txteditparts} (cgdisk)")
				diskpartcgdisk
				nextitem="${txteditparts} (cgdisk)"
			;;
		esac
		diskpartmenu "${nextitem}"
	fi
}


askswappart(){
	# Returns 0 when a swap partition (size = RAM) must be created
	dialog --backtitle "${apptitle}" --title "${1}" --yesno "${txtcreateswappart}" 0 0
}

getswapsize(){
	echo "$(( $(grep MemTotal /proc/meminfo | awk '{ print $2 }') / 1024 ))M"
}

wipedisk(){
	echo "${txtautopartclear}"
	echo "wipefs -a ${1}"
	wipefs -a ${1}
}

diskpartautodos(){
		device=$(selectdisk "${txtautoparts} (dos)")
	if [ "$?" = "0" ]; then
		if (dialog --backtitle "${apptitle}" --title "${txtautoparts} (dos)" --defaultno --yesno "${txtautopartsconfirm//%1/${device}}" 0 0) then
			askswappart "${txtautoparts} (dos)"
			withswap=$?
			clear
			wipedisk ${device}
			layout="label: dos\n,512M,L,*\n"
			if [ "${withswap}" = "0" ]; then
				layout="${layout},$(getswapsize),S\n"
			fi
			layout="${layout},,L\n"
			echo "${txtautopartcreate//%1/boot, swap, root}"
			echo -e "${layout}"
			echo -e "${layout}" | sfdisk ${device}
			echo ""
			pressanykey
			bootdev=$(partdev ${device} 1)
			if [ "${withswap}" = "0" ]; then
				swapdev=$(partdev ${device} 2)
				rootdev=$(partdev ${device} 3)
			else
				swapdev=
				rootdev=$(partdev ${device} 2)
			fi
			efimode="0"
		fi
	fi
}

diskpartautogpt(){
		device=$(selectdisk "${txtautoparts} (gpt)")
	if [ "$?" = "0" ]; then
		if (dialog --backtitle "${apptitle}" --title "${txtautoparts} (gpt)" --defaultno --yesno "${txtautopartsconfirm//%1/${device}}" 0 0) then
			askswappart "${txtautoparts} (gpt)"
			withswap=$?
			clear
			wipedisk ${device}
			sgdisk -o ${device}
			echo "${txtautopartcreate//%1/BIOS boot}"
			sgdisk ${device} -n=1:0:+31M -t=1:ef02 -c=1:mbrboot
			echo "${txtautopartcreate//%1/boot}"
			sgdisk ${device} -n=2:0:+1024M -t=2:8300 -c=2:boot
			rootpart=3
			if [ "${withswap}" = "0" ]; then
				echo "${txtautopartcreate//%1/swap}"
				sgdisk ${device} -n=3:0:+$(getswapsize) -t=3:8200 -c=3:swap
				rootpart=4
			fi
			echo "${txtautopartcreate//%1/root}"
			sgdisk ${device} -n=${rootpart}:0:0 -t=${rootpart}:8304 -c=${rootpart}:root
			echo ""
			pressanykey
			bootdev=$(partdev ${device} 2)
			if [ "${withswap}" = "0" ]; then
				swapdev=$(partdev ${device} 3)
			else
				swapdev=
			fi
			rootdev=$(partdev ${device} ${rootpart})
			efimode="0"
		fi
	fi
}

diskpartautoefi(){
		device=$(selectdisk "${txtautoparts} (gpt,efi)")
	if [ "$?" = "0" ]; then
		if (dialog --backtitle "${apptitle}" --title "${txtautoparts} (gpt,efi)" --defaultno --yesno "${txtautopartsconfirm//%1/${device}}" 0 0) then
			askswappart "${txtautoparts} (gpt,efi)"
			withswap=$?
			clear
			wipedisk ${device}
			sgdisk -o ${device}
			echo "${txtautopartcreate//%1/EFI boot}"
			sgdisk ${device} -n=1:0:+1024M -t=1:ef00 -c=1:boot
			rootpart=2
			if [ "${withswap}" = "0" ]; then
				echo "${txtautopartcreate//%1/swap}"
				sgdisk ${device} -n=2:0:+$(getswapsize) -t=2:8200 -c=2:swap
				rootpart=3
			fi
			echo "${txtautopartcreate//%1/root}"
			sgdisk ${device} -n=${rootpart}:0:0 -t=${rootpart}:8304 -c=${rootpart}:root
			echo ""
			pressanykey
			bootdev=$(partdev ${device} 1)
			if [ "${withswap}" = "0" ]; then
				swapdev=$(partdev ${device} 2)
			else
				swapdev=
			fi
			rootdev=$(partdev ${device} ${rootpart})
			efimode="1"
		fi
	fi
}

diskpartautoefiusb(){
		device=$(selectdisk "${txtautoparts} (gpt,efi)")  
	if [ "$?" = "0" ]; then
		if (dialog --backtitle "${apptitle}" --title "${txtautoparts} (gpt,efi)" --defaultno --yesno "${txtautopartsconfirm//%1/${device}}" 0 0) then
			clear
			wipedisk ${device}
			sgdisk -o ${device}
			echo "${txtautopartcreate//%1/EFI boot}"
			sgdisk ${device} -n=1:0:+1024M -t=1:ef00
			echo "${txtautopartcreate//%1/BIOS boot}"
			sgdisk ${device} -n=2:0:+31M -t=2:ef02
			echo "${txtautopartcreate//%1/root}"
			sgdisk ${device} -n=3:0:0 -t=3:8304
			echo "${txthybridpartcreate}"
			echo -e "r\nh\n3\nN\n\nY\nN\nw\nY\n" | gdisk ${device}
			echo ""
			pressanykey
			bootdev=$(partdev ${device} 1)
			swapdev=
			rootdev=$(partdev ${device} 3)
			efimode="2"
		fi
	fi
}

diskpartcfdisk(){
		device=$( selectdisk "${txteditparts} (cfdisk)" )
	if [ "$?" = "0" ]; then
		clear
		cfdisk ${device}
	fi
}

diskpartcgdisk(){
		device=$( selectdisk "${txteditparts} (cgdisk)" )
	if [ "$?" = "0" ]; then
		clear
		cgdisk ${device}
	fi
}
